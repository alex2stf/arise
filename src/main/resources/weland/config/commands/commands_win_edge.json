[
  {
    "id": "browser-open",
    "commands": [
      {
        "id": "process-exec",
        "args": ["C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe", "{0}"]
      }
    ]
  },
  {
    "id": "browser-close",
    "commands": [
      {
        "id": "process-exec",
        "args": ["taskkill", "/F", "/IM", "msedge.exe"]

      }
    ]
  },
  {
    "id": "close-media",
    "commands": [
      {
        "id": "process-exec",
        "args": ["taskkill", "/F", "/IM", "wmplayer.exe"]
      }
    ]
  },
  {
    "id": "play-media",
    "commands": [
      {
        "id": "process-exec",
        "args": ["C:\\Program Files\\Windows Media Player\\wmplayer.exe",  "{0}"]
      }
    ]
  },
  {
    "id": "set-desktop-background",
    "commands": [
      {
        "id": "process-exec",
        "args": [
          "$valid-file(C://Users//Administrator//AppData//Local//Microsoft//WindowsApps//python3.exe)",
          "$find-file-stream(#python_scripts/set_desktop_image.py)", "{0}", "{1}", "{2}"
        ],
        "store-key": "desk-img"
      }
    ]
  }
]